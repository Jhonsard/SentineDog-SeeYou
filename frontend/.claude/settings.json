{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm preview)",
      "Bash(pnpm format)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(bash scripts/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": ["Bash(pnpm add:*)", "Bash(pnpm remove:*)"],
    "deny": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./dist/**)",
      "Edit(./server/**)",
      "Edit(./shared/**)",
      "Edit(./patches/**)",
      "Edit(./vercel.json)",
      "Edit(./pnpm-lock.yaml)"
    ]
  }
}
