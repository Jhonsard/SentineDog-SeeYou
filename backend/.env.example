# Configuration de la base de données
# Pour utiliser PostgreSQL, définissez USE_POSTGRES=true et configurez les paramètres ci-dessous
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ids_ips_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ids_ips_db

# Configuration SMTP (optionnel)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_EMAIL=ids-ips@example.com
ADMIN_EMAIL=admin@example.com

# Configuration réseau
NETWORK_INTERFACE=wlan0
ALERT_THRESHOLD_PORT_SCAN=10
ALERT_THRESHOLD_SYN_FLOOD=100

# Configuration API
API_HOST=0.0.0.0
API_PORT=8000

# CORS (environnement: dev, test, prod)
CORS_ENVIRONMENT=dev
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Clé secrète JWT - GÉNÉRER UNE VALEUR SÉCURISÉE (min 32 caractères)
# Exemple de génération: openssl rand -hex 32
SECRET_KEY=

# Sécurité SSH (connexions aux nœuds de surveillance)
SSH_TIMEOUT_SECONDS=5
SSH_KNOWN_HOSTS_FILE=
SSH_STRICT_HOST_KEY_CHECKING=true

# Durcissement iptables / IPS
IPTABLES_TIMEOUT_SECONDS=2
IPTABLES_MAX_RETRIES=3

# Rate limiting API
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Configuration IA / RL
# HF_READ_TOKEN : token de lecture HuggingFace pour télécharger le modèle au démarrage.
# HF_WRITE_TOKEN : token d'écriture HuggingFace (optionnel, uniquement pour le push manuel depuis dev/colab).
# AI_HF_REPO_ID : identifiant du repo HuggingFace (ex: votre-username/rl-ids-agent).
# AI_HF_FILENAME : nom du fichier modèle dans le repo (par défaut rl_agent.keras).
HF_READ_TOKEN=hf_votre_token_de_lecture
HF_WRITE_TOKEN=
AI_HF_REPO_ID=jhonsard/NetIntrisionUL
AI_HF_FILENAME=SeeYou.keras

# Mode manuel global (désactive l'IA et force l'opérateur humain)
RL_MANUAL_MODE=false

# Apprentissage par démonstration humaine en mode manuel
# RL_MANUAL_MODE_LEARNING_ENABLED : si true, l'IA collecte les feedbacks humains et s'entraîne en arrière-plan.
# RL_MANUAL_MODE_TRAIN_INTERVAL : nombre de feedbacks avant de déclencher un entraînement (défaut: 100).
RL_MANUAL_MODE_LEARNING_ENABLED=false
RL_MANUAL_MODE_TRAIN_INTERVAL=100

# ---------------------------------------------------------------------------
# Plan MCP (Model Context Protocol) - audits IA
# ---------------------------------------------------------------------------
# MCP_API_KEY : clé de SECOURS statique (usage exceptionnel).
#   Le mode nominal est le registre de clés à scopes :
#     python -m scripts.mcp_key_admin create --name "agent-audit" --scopes read
#     python -m scripts.mcp_key_admin create --name "agent-correctif" --scopes read,write
#   Génération : python -c "import secrets;print('mcp_sk_'+secrets.token_urlsafe(48))"
MCP_API_KEY=
MCP_SERVER_NAME=ids_ips_mcp

# MCP_PUBLIC_HOSTNAME : hostname utilisé par les clients pour joindre le plan MCP.
MCP_PUBLIC_HOSTNAME=localhost
# MCP_ALLOWED_HOSTS : en-têtes Host acceptés, format "host:port" ou "host:*".
#   Si vide, dérivé de MCP_PUBLIC_HOSTNAME + API_PORT (+ localhost/127.0.0.1/idsips-api).
MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS : origines Navigateur autorisées. Vide = aucun navigateur
#   (recommandé : le plan MCP exécute iptables et n'a pas vocation à être exposé).
#   Les clients non-navigateur (Claude Desktop, CLI) n'envoient pas d'Origin.
MCP_ALLOWED_ORIGINS=

# Rate limiting du plan MCP
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_REQUESTS=60
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_RATE_LIMIT_MAX_BUCKETS=4096
MCP_RATE_LIMIT_MAX_SSE_CONNECTIONS=4

# mTLS : appliqué par le reverse proxy (Caddy), PAS par l'application.
# L'application exige l'attestation du proxy (en-tête + secret partagé).
MCP_MTLS_ENABLED=false
MCP_MTLS_PROXY_SECRET=
